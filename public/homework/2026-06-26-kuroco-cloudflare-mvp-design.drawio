        <mxCell id="title" value="AIニュース / SCS 有料化 MVP設計&#xa;Kuroco + Cloudflare で軽量に開始、重い処理はFastAPIへ段階拡張" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#213A5B;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1030" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="meta" value="2026/06/26 11:00 MTG向け / 高橋案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7F5;strokeColor=#087F7A;fontSize=15;fontStyle=1;fontColor=#213A5B;" vertex="1" parent="1">
          <mxGeometry x="1160" y="34" width="340" height="48" as="geometry"/>
