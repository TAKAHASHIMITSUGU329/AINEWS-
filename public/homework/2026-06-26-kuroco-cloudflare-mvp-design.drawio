        <mxCell id="summary-title" value="エグゼクティブサマリ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=22;fontStyle=1;fontColor=#213A5B;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="260" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="summary-1" value="宿題1: Kurocoでどこまでやるか&#xa;&#xa;回答: 初期MVPは Kuroco + Cloudflare で開始。&#xa;Kurocoは会員管理・CMS・無料/有料出し分けを担当。&#xa;Cloudflare Pagesは画面表示、Workersは軽量APIとGemini/Search API実行を担当。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF4FF;strokeColor=#2563EB;fontSize=15;fontColor=#182230;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="700" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="summary-2" value="宿題2: AI課金が青天井にならない方程式&#xa;&#xa;回答: 使い放題にしない。&#xa;AI検索回数、PDF生成回数、SCS診断回数に月間上限を設定。&#xa;月額料金 &gt;= 上限API原価 + サポート原価 + 利益 で設計。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E6;strokeColor=#B76E00;fontSize=15;fontColor=#182230;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="164" width="710" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="arch-title" value="初期MVPアーキテクチャ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=22;fontStyle=1;fontColor=#213A5B;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="320" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="ユーザー&#xa;未ログイン / 無料 / 有料 / 管理者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E0EA;fontSize=15;fontStyle=1;fontColor=#182230;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="190" height="90" as="geometry"/>
